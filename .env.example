# Copy to .env and adjust.
YTDL_HOST=127.0.0.1
YTDL_PORT=8000
# Required when binding to anything other than localhost.
YTDL_API_KEY=
YTDL_HEADLESS=true
# JS runtime yt-dlp uses for YouTube's signature challenges: bun, deno or node
YTDL_JS_RUNTIME=bun
YTDL_COOKIE_REFRESH_MINUTES=20
YTDL_MAX_CONCURRENT_EXTRACTIONS=2
YTDL_MAX_CONCURRENT_DOWNLOADS=1
